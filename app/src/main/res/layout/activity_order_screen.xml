<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OrderScreen">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme" />
    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
    </FrameLayout>

    <TableLayout
        android:id="@+id/add_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="40dp">
        <TableRow>
            <TextView
                android:text="Restaurant ID:"
                android:padding="3dip" />
            <EditText
                android:id="@+id/restaurant_ID_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </TableRow>
        <TableRow>
            <TextView
                android:text="Restaurant Name:"
                android:padding="3dip" />
            <EditText
                android:id="@+id/restaurant_name_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="150dip" />
        </TableRow>
        <TableRow>
            <TextView
                android:text="Style of Food:"
                android:padding="3dp" />
            <EditText
                android:id="@+id/food_style_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="150dip" />
        </TableRow>
        <TableRow>
            <TextView
                android:text="Location:"
                android:padding="3dp" />
            <EditText
                android:id="@+id/location_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="150dip" />
        </TableRow>
        <TableRow>
            <TextView
                android:text="Minimum Order Charge:"
                android:padding="3dp" />
            <EditText
                android:id="@+id/min_order_charge_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="150dip" />
        </TableRow>
        <TableRow>
            <TextView
                android:text="FoodDish ID:"
                android:padding="3dip" />
            <EditText
                android:id="@+id/food_dish_ID_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </TableRow>
        <TableRow>
            <TextView
                android:text="Food/Dish Name:"
                android:padding="3dip" />
            <EditText
                android:id="@+id/food_dish_name_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="150dip" />
        </TableRow>
        <TableRow>
            <TextView
                android:text="Restaurant:"
                android:padding="3dp" />
            <EditText
                android:id="@+id/restaurant_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="150dip" />
        </TableRow>
        <TableRow>
            <TextView
                android:text="Main Ingredients:"
                android:padding="3dp" />
            <EditText
                android:id="@+id/ingredients_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="150dip" />
        </TableRow>
        <TableRow>
            <TextView
                android:text="Price:"
                android:padding="3dp" />
            <EditText
                android:id="@+id/price_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="150dip" />
        </TableRow>
        <TableRow>
            <Button
                android:id="@+id/confirmOrderBtn"
                android:text="Confirm Order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="3dip" />
        </TableRow>
    </TableLayout>


</LinearLayout>