<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditFoodDish">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/response" />

        <TableLayout
            android:id="@+id/add_food_dish_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="40dp">

            <TableRow>

                <TextView
                    android:text="Food/Dish ID:"
                    android:padding="3dip" />

                <EditText
                    android:id="@+id/food_dish_ID_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

            </TableRow>

            <TableRow>

                <TextView
                    android:text="Dish Name:"
                    android:padding="3dip" />

                <EditText
                    android:id="@+id/dish_name_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="150dip"
                    android:inputType="textCapWords" />

            </TableRow>

            <TableRow>

                <TextView
                    android:text="Restaurant:"
                    android:padding="3dip" />

                <EditText
                    android:id="@+id/restaurant_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="150dip"
                    android:inputType="textCapWords" />

            </TableRow>

            <TableRow>

                <TextView
                    android:text="Main Ingredients:"
                    android:padding="3dip" />

                <EditText
                    android:id="@+id/main_ingredients_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="150dip"
                    android:inputType="textCapSentences" />

            </TableRow>

            <TableRow>

                <TextView
                    android:text="Price ($):"
                    android:padding="3dip" />

                <EditText
                    android:id="@+id/price_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="150dip"
                    android:inputType="numberDecimal" />

            </TableRow>

            <TableRow>

                <Button
                    android:id="@+id/confirm_edit_food_dish_button"
                    android:text="Confirm Edit Food/Dish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="3dip" />

                <Button
                    android:id="@+id/delete_food_dish_button"
                    android:text="Delete Food/Dish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="3dip" />

            </TableRow>

        </TableLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>