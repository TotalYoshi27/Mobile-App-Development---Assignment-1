<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainAdminScreen">


    <Button
        android:id="@+id/toResturantScreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginBottom="70dp"
        android:onClick="toResScreen"
        android:text="Resturant"
        app:layout_constraintBottom_toTopOf="@+id/toFoodDishScreen"
        app:layout_constraintStart_toStartOf="@+id/toFoodDishScreen"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <Button
        android:id="@+id/toFoodDishScreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="269dp"
        android:onClick="toFoodDishScreen"
        android:text="Food/Dish Screen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toResturantScreen" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="134dp"
        android:layout_height="0dp"
        android:layout_marginTop="179dp"
        android:layout_marginBottom="75dp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:text="Select where to go:"
        app:layout_constraintBottom_toTopOf="@+id/toResturantScreen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>